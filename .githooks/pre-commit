#!/bin/sh
# Check staged source bytes. Never edit or stage files during a commit.
if command -v python >/dev/null 2>&1; then
    exec python Tools/check_cpp_format.py --staged
elif command -v python3 >/dev/null 2>&1; then
    exec python3 Tools/check_cpp_format.py --staged
else
    echo "Loong pre-commit: Python is required to check staged C++ formatting." >&2
    exit 1
fi
