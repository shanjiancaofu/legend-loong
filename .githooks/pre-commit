#!/bin/sh
# Standard pre-commit runner; it protects unstaged edits and never stages fixes.
if command -v python >/dev/null 2>&1; then
    exec python -m pre_commit run --hook-stage pre-commit
elif command -v python3 >/dev/null 2>&1; then
    exec python3 -m pre_commit run --hook-stage pre-commit
else
    echo "Loong pre-commit: Python and pre-commit are required." >&2
    exit 1
fi
